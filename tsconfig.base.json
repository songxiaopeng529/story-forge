{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@story-forge/agent": ["packages/agent/src/index.ts"],
      "@story-forge/extensions": ["packages/extensions/src/index.ts"],
      "@story-forge/shared": ["packages/shared/src/index.ts"]
    }
  }
}
